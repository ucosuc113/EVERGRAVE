{
  "android": {
    "arm64": true,
    "immersive": true,
    "keepScreenOn": true,
    "minSdk": 26,
    "orientation": "sensorLandscape",
    "outputDir": "Build/Android",
    "packageName": "",
    "quality": {
      "aa": "",
      "enabled": false,
      "fps": 0,
      "lighting": "",
      "prepass": true,
      "scale": 1.0,
      "shadowAA": "",
      "shadows": "",
      "surface": 1.0
    },
    "targetSdk": 0,
    "versionCode": 1,
    "x86_64": true
  },
  "build": {
    "cleanFirst": false,
    "development": false,
    "excludeExtensions": ".cpp .h .hpp .inl .fbx .glb .gltf .blend .psd .ini",
    "excludeFolders": [
      "Assets/Scripts"
    ],
    "openFolder": true,
    "outputDir": "Build/Windows",
    "stopOnProblems": false,
    "zip": false
  },
  "input": {
    "cursor": "visible"
  },
  "platform": "android",
  "product": {
    "company": "",
    "copyright": "",
    "icon": "Assets/UI/moon-icon.png",
    "name": "EVERGRAVE",
    "version": "1.0.0"
  },
  "render": {
    "aa": "off",
    "lighting": "soft",
    "shadowAA": "off",
    "shadows": "low"
  },
  "scenes": [
    {
      "enabled": true,
      "name": "Main",
      "path": "Scenes/Main.strscene"
    }
  ],
  "web": {
    "embedHeight": 720,
    "embedWidth": 1280,
    "fullscreenButton": true,
    "language": "en",
    "outputDir": "Build/Web",
    "runInBackground": true,
    "startPrompt": "",
    "zip": true
  },
  "window": {
    "fullscreenToggle": true,
    "height": 720,
    "mode": "windowed",
    "resizable": true,
    "runInBackground": true,
    "vsync": true,
    "width": 1280
  }
}